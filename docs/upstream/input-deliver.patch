diff --git a/packages/client/ui-conversation/tests/input-deliver.client.spec.ts b/packages/client/ui-conversation/tests/input-deliver.client.spec.ts
new file mode 100644
index 0000000000..2de1bccdf9
--- /dev/null
+++ b/packages/client/ui-conversation/tests/input-deliver.client.spec.ts
@@ -0,0 +1,71 @@
+// @vitest-environment jsdom
+/** A plugin may deliver the composer's default message to another Session; without a claim the composer's own Session receives it. */
+import { randomUUID } from 'node:crypto'
+import { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { makeTranslate, TestSessions } from '@deepseek-ai/dsh-client-test-runtime'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import type { InputDelivery, SubmitOutcome } from '../src/client/contract/input.ts'
+import { InputHub } from '../src/client/input/hub.ts'
+import { zh } from '../src/client/locales.ts'
+
+async function composer() {
+  const ctx = new Context()
+  const sessions = new TestSessions(async (operation) => { await operation() }, ctx)
+  onTestFinished(async () => {
+    await sessions.disposeScopes()
+    await ctx.fiber.dispose()
+  })
+  ctx.provide('sessions', sessions)
+  const open = async () => {
+    const id = SessionId(`input-deliver-${randomUUID()}`)
+    await sessions.add({ id })
+    const reference = sessions.retain(id)
+    onTestFinished(() => { reference.release() })
+    await reference.ready
+    return reference.binding
+  }
+  const own = await open()
+  const other = await open()
+  const sendSession = vi.fn<(session: unknown, text: string) => Promise<SubmitOutcome>>(() => Promise.resolve({ kind: 'success' }))
+  ctx.provide('conversation', {
+    blocks: { storeFor: () => createSnapshotStore(undefined) },
+    sendSession,
+    serializeDraftAttachments: () => Promise.resolve({ attachments: [] }),
+    releaseDraftAttachment: () => {},
+  })
+  const shell = new InputHub(ctx, makeTranslate(zh, {})).shellFor(own)
+  const submit = (text: string): void => {
+    shell.setDraft(text)
+    shell.submit()
+  }
+  return { ctx, own, other, sendSession, submit }
+}
+
+it('delivers to the composer\'s own Session when no plugin claims the message', async () => {
+  const b = await composer()
+  const offered = vi.fn<(delivery: InputDelivery) => undefined>()
+  b.ctx.on('conversation/input-deliver', offered)
+  b.submit('  first question  ')
+  await vi.waitFor(() => { expect(b.sendSession).toHaveBeenCalledTimes(1) })
+  expect(b.sendSession.mock.calls[0]?.slice(0, 2)).toEqual([b.own.session, 'first question'])
+  expect(offered.mock.calls[0]?.[0]).toMatchObject({ sessionId: b.own.session.sessionId, text: 'first question' })
+})
+
+it('delivers the same draft to the Session a claiming plugin chooses, and to no other', async () => {
+  const b = await composer()
+  b.ctx.on('conversation/input-deliver', delivery => delivery.send(b.other.session))
+  b.submit('asked from an earlier turn')
+  await vi.waitFor(() => { expect(b.sendSession).toHaveBeenCalledTimes(1) })
+  expect(b.sendSession.mock.calls[0]?.slice(0, 2)).toEqual([b.other.session, 'asked from an earlier turn'])
+})
+
+it('reports a claiming plugin\'s failure to the composer without delivering anywhere', async () => {
+  const b = await composer()
+  const claimed = vi.fn(() => Promise.resolve<SubmitOutcome>({ kind: 'error', text: 'the branch was not created' }))
+  b.ctx.on('conversation/input-deliver', claimed)
+  b.submit('kept in the composer')
+  await vi.waitFor(() => { expect(claimed).toHaveBeenCalledTimes(1) })
+  expect(b.sendSession).not.toHaveBeenCalled()
+})
